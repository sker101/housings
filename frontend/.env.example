# Environment Template
# Copy this file to .env.local, .env.staging, or .env.production and fill in the values.

# Supabase Project Reference (e.g. iavflytaqfdwhmshocvm)
VITE_SUPABASE_PROJECT_REF=

# Supabase API URL
VITE_SUPABASE_URL=

# Supabase Anonymous Key (for public/client-side access)
VITE_SUPABASE_ANON_KEY=

# Backend API Base URL (defaults to /api/v1 if not set)
VITE_API_BASE_URL=