# Local Docker Postgres defaults
DB_URL=jdbc:postgresql://postgres:5432/campusstay
DB_USERNAME=campusstay
DB_PASSWORD=campusstay
DB_SSLMODE=disable

# Supabase override (production)
# DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# DB_USERNAME=postgres.YOUR_PROJECT_REF
# DB_PASSWORD=your-supabase-db-password
# DB_SSLMODE=require

JWT_SECRET=replace-with-strong-secret
JWT_EXPIRY_MINUTES=120
BOOTSTRAP_ADMIN_EMAIL=admin@campusstay.co.tz
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
BOOTSTRAP_ADMIN_PHONE=+255700000000
BOOTSTRAP_SEED_DEMO_DATA=true
CORS_ALLOWED_ORIGINS=http://localhost:3000

# AI photo inspection
APP_AI_ENABLED=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-4.1-mini
AI_MIN_CONFIDENCE=0.65
AI_MAX_IMAGE_BYTES=5242880
MULTIPART_MAX_FILE_SIZE=12MB
MULTIPART_MAX_REQUEST_SIZE=12MB
