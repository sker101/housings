# Default local testing database (Docker Postgres)
DB_URL=jdbc:postgresql://postgres:5432/campusstay
DB_USERNAME=campusstay
DB_PASSWORD=campusstay
DB_SSLMODE=disable
LOCAL_DB_NAME=campusstay
LOCAL_DB_USER=campusstay
LOCAL_DB_PASSWORD=campusstay
POSTGRES_PORT=5433

# Supabase production override example (replace DB_* above when deploying)
# DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# DB_USERNAME=postgres.YOUR_PROJECT_REF
# DB_PASSWORD=your-supabase-db-password
# DB_SSLMODE=require

# App/security settings
JWT_SECRET=change-me-super-secure-secret-and-base64-encode
JWT_EXPIRY_MINUTES=120
BOOTSTRAP_ADMIN_EMAIL=admin@campusstay.co.tz
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
BOOTSTRAP_ADMIN_PHONE=+255700000000
BOOTSTRAP_SEED_DEMO_DATA=true
CORS_ALLOWED_ORIGINS=http://localhost:3000

# AI photo inspection (required for automated room-angle verification)
APP_AI_ENABLED=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-4.1-mini
AI_MIN_CONFIDENCE=0.65
AI_MAX_IMAGE_BYTES=5242880
MULTIPART_MAX_FILE_SIZE=12MB
MULTIPART_MAX_REQUEST_SIZE=12MB

# Host port mappings
BACKEND_PORT=8081
FRONTEND_PORT=3000

# Optional local frontend dev proxy target (for `npm run dev`)
VITE_DEV_API_PROXY_TARGET=http://localhost:8081
